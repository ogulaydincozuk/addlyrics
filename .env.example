# ─────────────────────────────────────────────────────────────
# AddLyrics ortam değişkenleri
# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun.
# Gerçek anahtarları ASLA depoya eklemeyin.
# ─────────────────────────────────────────────────────────────

# Uygulamanın dışarıdan erişilen adresi (ödeme dönüş adresleri ve e-posta linkleri için)
APP_URL=http://localhost:3000

# En az 32 karakterlik rastgele gizli anahtar.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# PostgreSQL bağlantısı. Yerelde `npm run db:start` bu adresi kullanır.
DATABASE_URL=postgresql://addlyrics:addlyrics@127.0.0.1:54329/addlyrics
# Entegrasyon testleri için ayrı veritabanı (testler bu veritabanını temizler!)
TEST_DATABASE_URL=postgresql://addlyrics:addlyrics@127.0.0.1:54329/addlyrics_test

# ─────────────────────────── Ödeme ───────────────────────────
# mock    → yalnızca geliştirme: gerçek ödeme alınmaz, test ödeme sayfası açılır
# iyzico  → iyzico Checkout Form (IYZICO_* değişkenleri zorunlu)
# shopify → Shopify Storefront sepeti + Shopify Checkout (SHOPIFY_* değişkenleri zorunlu)
# none    → ödeme kapalı; paketler satın alınamaz
PAYMENT_PROVIDER=mock

# Test ödeme sağlayıcısına izin ver. NODE_ENV=production iken her durumda kapalıdır.
ALLOW_TEST_PAYMENTS=true

# iyzico (https://merchant.iyzipay.com → Ayarlar → Firma Ayarları)
# Sandbox: https://sandbox-api.iyzipay.com   Canlı: https://api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Shopify (isteğe bağlı — bağımsız site Shopify olmadan çalışır)
# SHOPIFY_STORE_DOMAIN örn: addlyrics.myshopify.com
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
# Sipariş doğrulaması için Admin API erişim anahtarı (read_orders yetkisi)
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Webhook imzası için uygulamanın "API secret key" değeri
SHOPIFY_WEBHOOK_SECRET=

# ─────────────────────────── Paketler ───────────────────────────
# Örnek (isSample) paketlerin satın alma akışında kullanılmasına izin ver.
# NODE_ENV=production iken her durumda kapalıdır.
ALLOW_SAMPLE_PACKAGES=true

# ─────────────────────────── Dosya depolama ───────────────────────────
# local → sunucu diskinde (yalnızca geliştirme / tek sunucu)
# s3    → S3 uyumlu depolama (AWS S3, Cloudflare R2, MinIO…)
# vercel-blob → Vercel Blob (gizli/private depo). Vercel'de depo projeye bağlanınca BLOB_STORE_ID ve OIDC
#               kendiliğinden gelir; Vercel dışında BLOB_READ_WRITE_TOKEN gerekir.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

S3_BUCKET=
S3_REGION=auto
# R2 / MinIO için uç nokta, örn: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Yükleme sınırları (MB)
UPLOAD_MAX_AUDIO_MB=200
UPLOAD_MAX_VIDEO_MB=2048
UPLOAD_MAX_IMAGE_MB=20
UPLOAD_MAX_DOC_MB=10

# ─────────────────────────── E-posta ───────────────────────────
# console → e-postalar sunucu konsoluna yazılır (geliştirme)
# smtp    → SMTP_* ile gönderilir
EMAIL_DRIVER=console
EMAIL_FROM="AddLyrics <bildirim@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Yeni sipariş ve müşteri mesajı bildirimlerinin gideceği ekip adresi
ADMIN_NOTIFICATION_EMAIL=

# ─────────────────────────── Telefon doğrulama (SMS) ───────────────────────────
# Ücretsiz deneme için telefon doğrulaması zorunludur. Bir telefonla en fazla 2 hesap doğrulanabilir.
# none    → SMS gönderilmez; telefon doğrulanamaz, deneme başlatılamaz (dürüst varsayılan)
# console → YALNIZCA geliştirme: kod sunucu günlüğüne yazılır (üretimde otomatik kapalıdır)
# twilio  → Twilio Verify (kodu Twilio üretir ve doğrular)
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ─────────────────────────── Ön izleme kesiti (ffmpeg) ───────────────────────────
# Tanımlıysa deneme ön izlemeleri ana dosyadan sunucuda otomatik kesilir (kısa kesit, ≤720p, logo filigranı).
# Filigran için overlay + scale2ref filtreleri olan tam bir ffmpeg sürümü gerekir (assets/watermark.png kullanılır).
# Tanımlı değilse ekip, editörün dışa aktardığı kısa/filigranlı ön izlemeyi elle yükler.
FFMPEG_PATH=

# ─────────────────────────── İlk yönetici ───────────────────────────
# `npm run db:seed` bu bilgilerle bir ADMIN hesabı oluşturur (yoksa).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ─────────────────────────── Zamanlanmış bakım (Vercel Cron) ───────────────────────────
# /api/cron/maintenance yalnızca "Authorization: Bearer <CRON_SECRET>" ile çalışır (Vercel bunu kendisi ekler).
CRON_SECRET=
